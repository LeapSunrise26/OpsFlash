<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="opsflash.exe"
        Arguments=""
        InstallLocation="C:\Program Files\LeapSunrise\OpsFlash">
    </Installer>
    <PackageInformation
        PackageName="OpsFlash"
        PackageDisplayName="OpsFlash"
        PublisherName="CN=LeapSunrise"
        PublisherDisplayName="LeapSunrise"
        Version="0.1.0.0"
        PackageDescription="OpsFlash">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.leesun.opsflash"
                Description="OpsFlash"
                DisplayName="OpsFlash"
                ExecutableName="opsflash.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>OpsFlash</DisplayName>
            <PublisherDisplayName>LeapSunrise</PublisherDisplayName>
            <Description>OpsFlash</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="opsflash.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
